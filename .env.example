# API authentication — comma-separated list of valid API keys
# Leave empty to disable auth (public access)
API_KEYS=

# Groq API key — for audio & video transcription
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Gemini API key — for image description & scanned PDF OCR
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# CORS allowed origins — comma-separated
# In production the API is same-origin via Next.js rewrites, so this is only needed for local dev
# Default: http://localhost:3000 (set to * for public API access)
CORS_ORIGINS=http://localhost:3000
